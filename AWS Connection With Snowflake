CREATE STORAGE INTEGRATION my_s3_integration
  TYPE = EXTERNAL_STAGE
  STORAGE_PROVIDER = 'S3'
  ENABLED = TRUE
  STORAGE_AWS_ROLE_ARN = 'arn:aws:iam::730335203498:role/snowflake-aws-role'
  STORAGE_ALLOWED_LOCATIONS = ('s3://snowflake-bucket-17/');
